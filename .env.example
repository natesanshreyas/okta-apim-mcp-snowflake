# ---- Okta (identity) ----
# Issuer of your Okta custom authorization server
OKTA_ISSUER=https://example.okta.com/oauth2/aus1a2b3c4d5e6f7g8h9
# API audience configured on the Okta authz server / APIM
OKTA_AUDIENCE=api://mcp-snowflake
# Public client ID of the Claude Desktop / device app registration in Okta
OKTA_CLIENT_ID=0oa1a2b3c4d5e6f7g8h9
# An access token with the snowflake.query scope (obtained via Auth Code + PKCE).
# NEVER commit a real token. This is only for local agent/smoke testing.
OKTA_ACCESS_TOKEN=

# ---- APIM (gateway) ----
APIM_RG=my-apim-rg
APIM_NAME=my-existing-apim
# Backend MCP server URL APIM routes to
MCP_BACKEND_URL=https://mcp.internal.example.com/mcp

# ---- MCP server ----
SNOWFLAKE_MODE=mock          # mock | real
MCP_HOST=0.0.0.0
MCP_PORT=8080
VERIFY_OKTA_TOKEN=0          # 1 = re-validate Okta JWT at the backend too

# ---- Snowflake (only when SNOWFLAKE_MODE=real) ----
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=MCP_DEMO_USER
SNOWFLAKE_ROLE=MCP_DEMO_ROLE
SNOWFLAKE_WAREHOUSE=MCP_DEMO_WH
SNOWFLAKE_DATABASE=MCP_DEMO_DB
SNOWFLAKE_SCHEMA=PUBLIC
# Key-pair auth: path to the RSA private key (source from Key Vault in prod)
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---- Azure-hosted LLM (agent) ----
AZURE_OPENAI_ENDPOINT=https://my-aoai.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01
# APIM MCP endpoint the agent calls (through the gateway)
MCP_ENDPOINT=https://my-existing-apim.azure-api.net/mcp-snowflake/mcp
