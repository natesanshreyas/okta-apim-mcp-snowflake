# ======== Okta (identity) ========
OKTA_ISSUER=https://example.okta.com/oauth2/aus1a2b3c4d5e6f7g8h9

# --- Chat client (PUBLIC, PKCE) : signs the user in ---
OKTA_CLIENT_ID=0oaPUBLICclientid
OKTA_AGENT_AUDIENCE=api://agent          # audience of the user token / Agent API

# --- Agent service (CONFIDENTIAL) : performs OBO token exchange ---
OKTA_AGENT_CLIENT_ID=0oaCONFIDENTIALid
OKTA_AGENT_CLIENT_SECRET=                 # from Key Vault; never commit
OKTA_MCP_AUDIENCE=api://mcp-snowflake     # audience minted by OBO for the MCP API
OKTA_MCP_SCOPE=snowflake.query

# MCP API audience + JWKS (used by the APIM MCP policy / named values)
OKTA_AUDIENCE=api://mcp-snowflake
OKTA_JWKS_URI=https://example.okta.com/oauth2/aus1a2b3c4d5e6f7g8h9/v1/keys

# A user access token (aud=api://agent, scope=agent.invoke) for local CLI tests.
# NEVER commit a real token.
OKTA_ACCESS_TOKEN=

# ======== APIM (gateway) ========
APIM_RG=my-apim-rg
APIM_NAME=my-existing-apim
AGENT_BACKEND_URL=https://agent.internal.example.com/agent   # agent service URL
MCP_BACKEND_URL=https://mcp.internal.example.com/mcp         # MCP server URL

# ======== Agent service -> Azure-hosted model ========
AZURE_OPENAI_ENDPOINT=https://my-aoai.openai.azure.com
AZURE_OPENAI_API_KEY=                     # or use managed identity
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01
# APIM MCP API the agent calls (through the gateway) on the OBO hop
MCP_ENDPOINT=https://my-existing-apim.azure-api.net/mcp-snowflake/mcp

# ======== MCP server ========
SNOWFLAKE_MODE=mock                        # mock | real
MCP_HOST=0.0.0.0
MCP_PORT=8080
VERIFY_OKTA_TOKEN=0                         # 1 = re-validate the OBO JWT at the backend

# ======== Snowflake (only when SNOWFLAKE_MODE=real) ========
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=MCP_DEMO_USER
SNOWFLAKE_ROLE=MCP_DEMO_ROLE
SNOWFLAKE_WAREHOUSE=MCP_DEMO_WH
SNOWFLAKE_DATABASE=MCP_DEMO_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
